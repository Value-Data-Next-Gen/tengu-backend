DATABASE_URL=sqlite:///./data/tengu.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true

FRONTEND_URL=http://localhost:5173
WEBPAY_RETURN_URL=http://localhost:8000/api/checkout/webpay/return

# --- Admin ---
# Emails autorizados para recibir el magic link de admin (separados por coma)
ADMIN_EMAILS=g.rojaschacon@gmail.com
# IMPORTANTE en producción: pon un secret fijo aquí. Si no, los JWTs se invalidan al reiniciar.
JWT_SECRET=cambiame-en-produccion
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_HOURS=72

# --- Email ---
# En dev: SMTP_HOST=__console__ imprime el magic link en la consola.
# En prod: usa Brevo (smtp-relay.brevo.com), Resend, o tu SMTP.
SMTP_HOST=__console__
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Tengu Roastery <hola@tenguroastery.cl>
SMTP_USE_TLS=true
