DATABASE_URL=sqlite:///./data/tengu.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true

# En Azure App Service: path absoluto bajo /home (única zona persistente
# entre redeploys de GitHub Actions). En dev queda vacío y cae a backend/uploads.
# CUIDADO con Git Bash en Windows: `az ... --settings UPLOADS_DIR=/home/uploads`
# se convierte a "C:/Program Files/Git/home/uploads" por traducción MSYS.
# Workarounds: setealo desde Azure Portal, o usa `MSYS_NO_PATHCONV=1 az ...`.
UPLOADS_DIR=

FRONTEND_URL=http://localhost:5173
WEBPAY_RETURN_URL=http://localhost:8000/api/checkout/webpay/return

# --- Webpay (Transbank) ---
# 'test' = sandbox público (no requiere afiliación). 'live' = producción.
WEBPAY_ENVIRONMENT=test
# Solo necesarios cuando WEBPAY_ENVIRONMENT=live. Te los entrega Transbank
# después de la afiliación. Ver backend/docs/WEBPAY-SETUP.md
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=

# --- Khipu (transferencia bancaria) ---
# Crear cuenta en https://khipu.com (gratuito, sin papeleo). En el panel
# Cobrar > Tu información sacas receiver_id y secret/api key.
# Si quedan vacíos, los endpoints /api/checkout/khipu/* devuelven 503.
KHIPU_RECEIVER_ID=
KHIPU_API_KEY=

# --- Mercado Pago Checkout Pro ---
# Crear app en https://www.mercadopago.cl/developers/panel/app → Credenciales.
# TEST-... = sandbox (no cobra plata real). APP_USR-... = producción.
# Webhook URL del panel debe apuntar a /api/checkout/mercadopago/notify
# Si MP_ACCESS_TOKEN queda vacío, los endpoints /mercadopago/* devuelven 503.
MP_ACCESS_TOKEN=
MP_ENVIRONMENT=test

# --- Admin ---
# Emails autorizados (separados por coma). Cualquiera de éstos + ADMIN_PASSWORD permite entrar.
ADMIN_EMAILS=g.rojaschacon@gmail.com
# Password compartido. CAMBIAR EN PRODUCCIÓN.
ADMIN_PASSWORD=tengu123
# IMPORTANTE en producción: pon un secret fijo. Si no, los JWTs se invalidan al reiniciar.
JWT_SECRET=cambiame-en-produccion
SESSION_TTL_HOURS=72

# --- Email ---
# En dev: SMTP_HOST=__console__ imprime el magic link en la consola.
# En prod: usa Brevo (smtp-relay.brevo.com), Resend, o tu SMTP.
SMTP_HOST=__console__
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=Tengu Roastery <hola@tenguroastery.cl>
SMTP_USE_TLS=true
